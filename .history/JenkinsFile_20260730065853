pipeline {

    agent any
   environment {
        JMETER_HOME = "C:\\Users\\Kunde\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
        PATH = "C:\\Windows\\System32;C:\\Windows;${JAVA_HOME}\\bin;%PATH%"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Check Windows Tools') {
         steps {
        bat '''
        echo PATH=%PATH%
        echo JAVA_HOME=%JAVA_HOME%
        echo JMETER_HOME=%JMETER_HOME%
        '''
          }
      }
        stage('Run JMeter Test') {
            steps {
                bat '''
                rmdir /s /q jmeter-report 2>nul
                del /f /q results.jtl 2>nul
                echo JAVA_HOME=%JAVA_HOME%
                java -version

                %JMETER_HOME%\\bin\\jmeter.bat ^
                -n ^
                -t Tests\\Testplan.jmx ^
                -l results.jtl ^
                -e ^
                -o jmeter-report
                '''
            }
        }

        stage('Publish JMeter Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'jmeter-report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report'
                ])
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'results.jtl'
            }
        }
    }

    post {
        always {
            echo "JMeter test finished"
        }
    }
}