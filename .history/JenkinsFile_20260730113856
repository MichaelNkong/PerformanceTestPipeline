pipeline {
    
     agent {
        docker {
            image 'alpine/jmeter:5.6'
            args '-v $PWD:/workspace'
        }
    }
   environment {
        DOCKER_HOME = "C:\\Program Files\\Docker\\Docker\\resources"
        JMETER_HOME = "C:\\Users\\Kunde\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
        PATH = "C:\\Windows\\System32;C:\\Windows;${JAVA_HOME}\\bin;${DOCKER_HOME}\\bin; %PATH%"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Check Windows Tools') {
         steps {
        bat '''
        echo PATH=%PATH%
        echo JAVA_HOME=%JAVA_HOME%
        echo JMETER_HOME=%JMETER_HOME%
        '''
          }
      }
        
        stage('Run JMeter') {
            steps {
                sh '''
                cd /workspace

                jmeter -n \
                -t Tests/Testplan.jmx \
                -l results.jtl \
                -e \
                -o jmeter-report
                '''
            }
        }


        stage('Publish JMeter Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'jmeter-report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report'
                ])
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'results.jtl'
            }
        }
    }

    post {
        always {
            echo "JMeter test finished"
        }
    }
}